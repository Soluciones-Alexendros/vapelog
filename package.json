    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nitro": "3.0.260903-beta",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-bundle-visualizer": "^1.2.1"
