{
  "name": "vapelog",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/data/*.test.ts\" \"scripts/*.test.mjs\"",
    "test:coverage": "node --experimental-test-coverage --test \"src/data/*.test.ts\" \"scripts/*.test.mjs\"",
    "smoke": "bash scripts/smoke.sh",
    "visual-smoke": "node scripts/visual-smoke.mjs",
    "smoke-bench": "node scripts/smoke-bench.mjs",
    "smoke-verify": "node scripts/smoke-verify.mjs",
    "check:env": "node scripts/check-env.mjs",
    "icons": "node scripts/build-icons.mjs",
    "logo": "node scripts/build-logo.mjs",
    "sitemap": "node scripts/build-sitemap.mjs",
    "images": "node scripts/build-images.mjs",
    "a11y": "node scripts/a11y-pass.mjs",
    "e2e": "bash scripts/e2e.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
